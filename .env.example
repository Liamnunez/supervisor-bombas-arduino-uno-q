# ============================================================
# .env.example - Supervisor de Bombas environment variables
# Copy to .env and fill in your values
# ============================================================

# ----------------------------------------------------------
# Serial / MCU
# ----------------------------------------------------------
SUPERVISOR_SERIAL_PORT=/dev/ttyACM0

# ----------------------------------------------------------
# Authentication (REQUIRED for remote commands)
# Generate with: openssl rand -hex 32
# ----------------------------------------------------------
SUPERVISOR_OPERATOR_PASSWORD=your_operator_password_here
SUPERVISOR_ADMIN_PASSWORD=your_admin_password_here
SUPERVISOR_AUTH_SECRET=your_32_byte_hex_secret_here
SUPERVISOR_TOKEN_TTL_S=28800

# ----------------------------------------------------------
# Database paths (inside container: /data/)
# ----------------------------------------------------------
SUPERVISOR_ALERTS_DB=/data/alerts.db
SUPERVISOR_AUDIT_LOG=/data/audit.log
SUPERVISOR_MAINTENANCE_DB=/data/maintenance.db
SUPERVISOR_METRICS_DB=/data/metrics.db

# ----------------------------------------------------------
# Telegram Bot (optional)
# Get token from @BotFather, chat_id from @userinfobot
# ----------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ----------------------------------------------------------
# Maintenance thresholds (hours)
# ----------------------------------------------------------
MAINT_OIL_HOURS=500
MAINT_BEARING_HOURS=2000

# ----------------------------------------------------------
# PostgreSQL (optional, for centralized storage)
# ----------------------------------------------------------
# POSTGRES_PASSWORD=