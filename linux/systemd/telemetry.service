[Unit]
Description=Supervisor de Bombas - Telemetría FastAPI
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/administrador/opencode-test/linux
Environment=PATH=/home/administrador/opencode-test/linux/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/home/administrador/opencode-test/linux/venv/bin/python -m app.main
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=telemetry

# Autenticación (definir en /etc/systemd/system/telemetry.service.d/override.conf
# o con `systemctl edit telemetry` — NUNCA en este archivo base)
# Environment=SUPERVISOR_OPERATOR_PASSWORD=...
# Environment=SUPERVISOR_ADMIN_PASSWORD=...
# Environment=SUPERVISOR_AUTH_SECRET=...
# Environment=TELEGRAM_BOT_TOKEN=...
# Environment=TELEGRAM_CHAT_ID=...
Environment=SUPERVISOR_AUDIT_LOG=/home/administrador/opencode-test/linux/audit.log
Environment=SUPERVISOR_ALERTS_DB=/home/administrador/opencode-test/linux/alerts.db

# Seguridad
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/home/administrador/opencode-test/linux

[Install]
WantedBy=multi-user.target